# Patient data never enters this repository. The four data directories are
# tracked (via .gitkeep) so a fresh clone can run; their contents are not.
data/*
results/*
figures/*
raw_data/*

*.csv
*.xlsx
*.xls
__pycache__/
.Rhistory
.RData
.env

# Exceptions, last so they override the blanket rules above.
!data/.gitkeep
!results/.gitkeep
!figures/.gitkeep
!raw_data/.gitkeep

# The 51 published intervals: an aggregate over groups of no fewer than
# 5,421 records, identical to Tables 1-3 of the paper. No patient-level
# information. Committed so the figures rebuild from a clean clone.
!results/reference_intervals.csv

# Figures 1-3 of the paper.
!figures/*.png
!figures/*.pdf
