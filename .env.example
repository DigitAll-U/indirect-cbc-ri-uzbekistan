# Copy to .env and edit if your data lives outside the repository.
# All four default to folders inside the repo, so most users need nothing here.

# Source LIS exports (*.xlsx). CONTAINS IDENTIFIERS - keep outside the repo.
RAW_DIR=raw_data

# De-identified and validated cohort CSVs
DATA_DIR=data

# Analysis outputs: intervals CSV, validation report, session info
RESULT_DIR=results

# Figure output
FIG_DIR=figures
